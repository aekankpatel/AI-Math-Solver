# Frontend build-time settings (Vite inlines VITE_* variables into the public bundle:
# never put secrets here). Copy to .env.local for local overrides.

# Backend base URL. Empty = same origin (the Vite dev proxy or the nginx container).
# Production (Vercel): https://mathenza-api.onrender.com   (your Render URL: https, no trailing slash)
VITE_API_URL=
