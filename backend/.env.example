# Copy to backend/.env and fill in. Never commit the real .env file.
# Free API key: https://console.groq.com/keys  (optional - the app works offline without it)
GROQ_API_KEY=
# Cloud sessions whose egress proxy injects the Authorization header (network secret for
# api.groq.com) use GROQ_AUTH=proxy instead of a key. Default: api_key.
GROQ_AUTH=api_key
LLM_MODEL=openai/gpt-oss-120b
LLM_ENABLED=true
LLM_MAX_RETRIES=1
LLM_STRUCTURED_METHOD=json_schema
LLM_EXPLANATIONS=false

# Global Groq budget per rolling 24 h (free tier for gpt-oss-120b: 200k tokens, 1,000 requests)
LLM_DAILY_TOKEN_BUDGET=150000
LLM_DAILY_REQUEST_BUDGET=800
# LLM_BUDGET_STATE_PATH=/data/budget.json   # persist the ledger across restarts

# Per-client limits
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=300
LLM_CALLS_PER_CLIENT_PER_DAY=40
TRUSTED_PROXY_HOPS=0   # 1 behind one reverse proxy that appends X-Forwarded-For

# Computation sandbox
SANDBOX_WORKERS=2
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_MB=1536

ENABLE_DOCS=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
